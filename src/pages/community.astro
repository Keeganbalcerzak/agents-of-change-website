---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CTASection from "@/components/CTASection.astro";
import CommunityHubExplorer from "@/components/islands/CommunityHubExplorer";

const localGroups = [
  { city: "Chicago", stateCode: "IL", members: 420, label: "LCSW Prep & Networking" },
  { city: "New York", stateCode: "NY", members: 850, label: "LMSW Study Group" },
  { city: "Los Angeles", stateCode: "CA", members: 630, label: "Clinical Networking" },
  { city: "Austin", stateCode: "TX", members: 215, label: "LSW Peer Support" },
  { city: "Atlanta", stateCode: "GA", members: 340, label: "Exam Strategy Group" },
  { city: "Seattle", stateCode: "WA", members: 190, label: "CE Credit Accountability" },
];

const interestForums = [
  { topic: "Child Psychology", threads: 142, icon: "🧸" },
  { topic: "Couples Counseling", threads: 98, icon: "🤝" },
  { topic: "Substance Abuse", threads: 215, icon: "🫂" },
  { topic: "School Social Work", threads: 175, icon: "🏫" },
  { topic: "Medical / Hospital", threads: 110, icon: "🏥" },
  { topic: "Private Practice Setup", threads: 340, icon: "🏢" },
];

const jobs = [
  { title: "Clinical Social Worker (LCSW)", company: "Sunrise Health System", location: "Chicago, IL (Hybrid)", stateCode: "IL", type: "Full-Time" },
  { title: "School Social Worker", company: "Lincoln Public Schools", location: "Seattle, WA", stateCode: "WA", type: "Full-Time" },
  { title: "Substance Abuse Counselor", company: "Pathways Recovery", location: "Austin, TX", stateCode: "TX", type: "Part-Time" },
  { title: "Telehealth Therapist", company: "Mindful Care", location: "Remote (NY Licensure)", stateCode: "NY", type: "Contract" },
];
---

<BaseLayout
  title="Social Worker Community | Agents of Change"
  description="Connect with local study groups, join specialty forums, and find job opportunities."
  path="/community"
  themeIntent="editorial"
  enableMotionEngine={true}
>
  <section class="page-hero page-hero-rich" data-module="community-hero" data-motion-tier="hero">
    <div class="container">
      <p class="eyebrow">Community Hub</p>
      <h1 data-split-heading>Meet social workers near you</h1>
      <p>
        Agents of Change isn't just an exam prep platform. It's a growing network of thousands of clinical and macro social workers supporting each other from licensure to private practice.
      </p>
    </div>
  </section>

  <section class="section section-muted" data-module="community-explorer" data-motion-variant="reveal-stagger" data-motion-density="compact">
    <div class="container">
      <header class="section-heading centered">
        <p class="eyebrow">Community matches</p>
        <h2>Find the right group, specialty lane, or role faster</h2>
        <p>Filter by city, state, specialty, and role, then jump directly into the next page or support path that matches.</p>
      </header>
      <CommunityHubExplorer client:load groups={localGroups} forums={interestForums} jobs={jobs} />
    </div>
  </section>

  <CTASection
    title="Grow your network today"
    description="Sign up for an Agents of Change account to join study groups and access the full job board."
  />
</BaseLayout>
