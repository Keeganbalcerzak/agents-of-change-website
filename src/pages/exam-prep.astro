---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProgramOffers from "@/components/ProgramOffers.astro";
import CTASection from "@/components/CTASection.astro";
import CurriculumArchitecture from "@/components/CurriculumArchitecture.astro";
import StudyJourneyTimeline from "@/components/StudyJourneyTimeline.astro";
import CompetencyGrid from "@/components/CompetencyGrid.astro";
import GaugeMini from "@/components/vendor/animata/GaugeMini.astro";
import {
  getCompetencyDomains,
  getProgramOffers,
  getSeoMetadata,
  getStudyPhases,
} from "@/lib/content";
import { findSeoByKey } from "@/lib/seo";

const [offers, seoEntries, domains, phases] = await Promise.all([
  getProgramOffers(),
  getSeoMetadata(),
  Promise.resolve(getCompetencyDomains()),
  Promise.resolve(getStudyPhases()),
]);
const seo = findSeoByKey(seoEntries, "exam-prep");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: "Social Work Exam Prep Program",
  description:
    "Comprehensive BSW, LSW, LMSW, and LCSW exam prep with structured modules, rationales, and weekly milestones.",
  provider: {
    "@type": "Organization",
    name: "Agents of Change",
  },
};
---

<BaseLayout
  title={seo?.title ?? "Exam Prep Programs | Agents of Change"}
  description={seo?.description ?? "Compare social work exam prep options."}
  path="/exam-prep"
  jsonLd={jsonLd}
  themeIntent="conversion"
  enableMotionEngine={true}
>
  <section class="page-hero page-hero-rich" data-module="exam-prep-hero" data-motion-tier="hero" data-motion-variant="story-stack" data-motion-density="cinematic">
    <div class="container">
      <p class="eyebrow">Exam prep</p>
      <h1 data-split-heading>Exam prep built to help you pass with confidence</h1>
      <p>
        Choose BSW-specific prep or guided support for LSW, LMSW, and LCSW, with clear instruction, realistic
        practice, and support that fits busy social work schedules.
      </p>
    </div>
  </section>

  <CurriculumArchitecture motionVariant="legendary-scrub" motionDensity="cinematic" />
  <StudyJourneyTimeline phases={phases} motionVariant="story-stack" motionDensity="cinematic" />
  <CompetencyGrid domains={domains} motionVariant="reveal-stagger" motionDensity="compact" />

  <section
    class="section exam-prep-outcomes-hybrid"
    data-module="exam-prep-outcomes"
    data-motion-tier="section"
    data-motion-variant="story-stack"
    data-motion-density="cinematic"
    aria-labelledby="outcomes-title"
  >
    <div class="container">
      <header class="section-heading centered">
        <p class="eyebrow">Why students see progress</p>
        <h2 id="outcomes-title">A study approach built for steady score improvement</h2>
      </header>

      <div class="outcomes-grid" data-stagger="up">
        <article class="info-card reveal" data-stagger-item data-tilt>
          <div class="outcome-gauge-row">
            <GaugeMini value={84} label="Readiness lift" />
          </div>
          <h3>Outcome 1: Stronger answer confidence</h3>
          <p>Students report faster elimination decisions and less second-guessing under timed conditions.</p>
        </article>
        <article class="info-card reveal" data-stagger-item data-tilt>
          <div class="outcome-gauge-row">
            <GaugeMini value={78} label="Pacing control" />
          </div>
          <h3>Outcome 2: Better pacing control</h3>
          <p>Simulation cycles improve rhythm and reduce time pressure in the final third of the exam.</p>
        </article>
        <article class="info-card reveal" data-stagger-item data-tilt>
          <div class="outcome-gauge-row">
            <GaugeMini value={88} label="Momentum consistency" />
          </div>
          <h3>Outcome 3: Predictable study momentum</h3>
          <p>Milestone-based sequencing prevents content drift and keeps weekly progress measurable.</p>
        </article>
      </div>
    </div>
  </section>

  <ProgramOffers offers={offers} showHeading={false} visualVariant="premium-hybrid" />

  <section class="section exam-prep-handoff" aria-labelledby="ce-state-title" data-module="ce-state-lookup" data-motion-tier="section">
    <div class="container">
      <header class="section-heading centered">
        <p class="eyebrow">After you pass</p>
        <h2 id="ce-state-title">Once you pass, continuing education becomes the next step.</h2>
        <p>
          After licensure, the focus shifts from exam prep to maintaining your license with the right CE hours,
          deadlines, and course choices for your state.
        </p>
      </header>

      <div class="exam-prep-handoff-grid" data-stagger="up">
        <article class="exam-prep-handoff-card" data-stagger-item>
          <p class="exam-prep-handoff-step">Stage 1</p>
          <h3>Prepare</h3>
          <p>Use exam prep to build readiness, pacing, and stronger answer confidence.</p>
        </article>
        <article class="exam-prep-handoff-card" data-stagger-item>
          <p class="exam-prep-handoff-step">Stage 2</p>
          <h3>Pass</h3>
          <p>Cross the licensure milestone and close out the exam-prep phase with a passing result.</p>
        </article>
        <article class="exam-prep-handoff-card is-bridge" data-stagger-item>
          <p class="exam-prep-handoff-step">Stage 3</p>
          <h3>Maintain with CE</h3>
          <p>Move into continuing education once renewal cadence, CE hours, and practical coursework become the next priority.</p>
        </article>
      </div>

      <div class="exam-prep-handoff-actions">
        <a href="/continuing-education" class="button primary btn-magnetic" data-magnetic>Explore continuing education</a>
        <a href="/state-requirements" class="button secondary">Check state requirements</a>
      </div>
    </div>
  </section>

  <CTASection
    title="Start with a personalized exam roadmap"
    description="Complete your free trial and receive a personalized 7-day study plan aligned to your exam track and timeline."
  />
</BaseLayout>
