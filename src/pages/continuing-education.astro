---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CTASection from "@/components/CTASection.astro";
import CeCatalogFilter from "@/components/islands/CeCatalogFilter";
import { getCeCatalog, getSeoMetadata } from "@/lib/content";
import { findSeoByKey } from "@/lib/seo";

const courses = getCeCatalog();
const seoEntries = await getSeoMetadata();
const seo = findSeoByKey(seoEntries, "continuing-education");

const valueCards = [
  {
    title: "State requirement confidence",
    copy: "Start with the renewal cadence, CE hour totals, and requirement context that shape what licensed social workers actually need next.",
  },
  {
    title: "Coursework with practical relevance",
    copy: "Choose topics that support clinical judgment, ethics, supervision, leadership, and real-world practice instead of checking a generic box.",
  },
  {
    title: "Renewal clarity without deadline panic",
    copy: "Use the catalog and state-aware planning flow to make CE completion feel orderly long before renewal windows close.",
  },
  {
    title: "Professional development beyond minimum hours",
    copy: "Keep growing in your work, not just checking a renewal box.",
  },
];

const bridgePoints = [
  "Many students return after passing because they want one trusted place for CE courses, live events, and renewal support.",
  "Exam prep ends at licensure; continuing education starts when renewal and ongoing growth become the priority.",
  "State requirements pages help turn renewal rules into clear next steps.",
];
---

<BaseLayout
  title={seo?.title ?? "Continuing Education Catalog | Agents of Change"}
  description={seo?.description ?? "Browse continuing education options built for licensed social workers, renewals, and professional growth."}
  path="/continuing-education"
  themeIntent="conversion"
  enableMotionEngine={true}
>
  <section class="page-hero page-hero-rich" data-module="ce-hero" data-motion-tier="hero" data-motion-variant="story-stack">
    <div class="container">
      <p class="eyebrow">Continuing education</p>
      <h1 data-split-heading>Continuing education built for licensed social workers</h1>
      <p>
        Built for licensed social workers who want renewal clarity, practical courses, and ongoing professional growth.
      </p>
    </div>
  </section>

  <section class="section ce-value-shell" aria-labelledby="ce-value-title" data-module="ce-value" data-motion-variant="reveal-stagger" data-motion-density="compact">
    <div class="container">
      <header class="section-heading centered">
        <p class="eyebrow">Why social workers choose us</p>
        <h2 id="ce-value-title">CE should feel useful, current, and easy to manage.</h2>
        <p>
          Agents of Change Continuing Education helps licensed social workers stay current with practical courses,
          live learning, and clear renewal guidance.
        </p>
      </header>

      <div class="ce-value-grid" data-stagger="up">
        {valueCards.map((card) => (
          <article class="info-card ce-value-card" data-stagger-item data-tilt>
            <h3>{card.title}</h3>
            <p>{card.copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="ce-catalog" class="section section-muted" data-module="ce-catalog-shell" data-motion-tier="section">
    <div class="container">
      <header class="section-heading centered">
        <p class="eyebrow">Catalog</p>
        <h2>Find the right CE path by practical criteria</h2>
        <p>Use filtering to target the right hours, topics, and formats without browsing the catalog blindly.</p>
      </header>

      <CeCatalogFilter client:load courses={courses} />
    </div>
  </section>

  <section class="section ce-bridge-shell" aria-labelledby="ce-bridge-title" data-module="ce-bridge" data-motion-variant="reveal-stagger" data-motion-density="compact">
    <div class="container">
      <header class="section-heading centered">
        <p class="eyebrow">After you pass</p>
        <h2 id="ce-bridge-title">Many students stay with Agents of Change after the exam.</h2>
        <p>
          Once the exam is behind you, the focus shifts to renewal requirements, live learning, and continuing growth
          in practice.
        </p>
      </header>

      <div class="ce-bridge-card">
        <ul>
          {bridgePoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
        <div class="ce-bridge-actions">
          <a href="/state-requirements" class="button secondary">Check state requirements</a>
          <a href="/about" class="button secondary">See the teaching approach</a>
        </div>
      </div>
    </div>
  </section>

  {/* ── Competitive Pricing Comparison ── */}
  <section class="section section-muted" aria-labelledby="ce-compare-title" data-module="ce-pricing-compare" data-motion-variant="reveal-stagger" data-motion-density="compact">
    <div class="container">
      <header class="section-heading centered">
        <p class="eyebrow">How AoC compares</p>
        <h2 id="ce-compare-title">See how Agents of Change CE stacks up</h2>
        <p>
          We price CE to be the best value in the category without cutting corners on content quality or provider credibility.
        </p>
      </header>

      <div class="pricing-compare-table-wrap">
        <table class="pricing-compare-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th class="compare-highlight">Agents of Change</th>
              <th>PESI</th>
              <th>NetCE</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Annual price</td>
              <td class="compare-highlight"><strong>$99/year</strong> <span class="compare-note">($49 first year)</span></td>
              <td>$250/year</td>
              <td>$89/year</td>
            </tr>
            <tr>
              <td>Course library</td>
              <td class="compare-highlight">150+ courses</td>
              <td>Varies by purchase</td>
              <td>Unlimited recorded</td>
            </tr>
            <tr>
              <td>Live events</td>
              <td class="compare-highlight">15+ live webinars/year</td>
              <td>Conference-based (extra cost)</td>
              <td>None included</td>
            </tr>
            <tr>
              <td>ASWB ACE provider</td>
              <td class="compare-highlight">Yes (#1919)</td>
              <td>Yes</td>
              <td>Yes</td>
            </tr>
            <tr>
              <td>Community access</td>
              <td class="compare-highlight">Mentorship, events, alumni network</td>
              <td>None</td>
              <td>None</td>
            </tr>
            <tr>
              <td>Best for recent exam passers</td>
              <td class="compare-highlight">Easy transition into CE after licensure</td>
              <td>Standalone CE offering</td>
              <td>Standalone CE offering</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <CTASection
    title="Choose CE with clarity before renewal pressure hits"
    description="Browse the continuing education catalog and use state requirement context to build a cleaner renewal plan."
    ctaLabel="Browse continuing education"
    ctaHref="/continuing-education#ce-catalog"
  />
</BaseLayout>
