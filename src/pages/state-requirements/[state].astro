---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CTASection from "@/components/CTASection.astro";
import { getStateRequirements } from "@/lib/content";
import type { StateRequirement } from "@/lib/types";
import { stateCodeToName } from "@/lib/states";

export async function getStaticPaths() {
  const states = await getStateRequirements();
  return states.map((state) => ({
    params: {
      state: state.stateCode.toLowerCase(),
    },
    props: {
      state,
    },
  }));
}

const { state } = Astro.props as { state: StateRequirement };
const pageTitle = `${state.stateName} Social Work Requirements | Agents of Change`;
const pageDescription =
  state.metaDescription || `Licensing and exam prep guidance for ${state.stateName} social workers.`;
const reviewedDate = state.updatedAt ? new Date(state.updatedAt) : null;
const reviewedLabel =
  reviewedDate && !Number.isNaN(reviewedDate.valueOf())
    ? reviewedDate.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })
    : "Recently";

const neighboringStates = ["CA", "TX", "NY", "FL", "WA"].filter((code) => code !== state.stateCode).slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `${state.stateName} social work requirements`,
  description: pageDescription,
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path={`/state-requirements/${state.stateCode.toLowerCase()}`}
  jsonLd={jsonLd}
  themeIntent="trust"
  enableMotionEngine={true}
>
  <section
    class="page-hero page-hero-rich"
    data-module="state-hero"
    data-motion-tier="hero"
    data-motion-variant="story-stack"
    data-motion-density="compact"
  >
    <div class="container">
      <p class="eyebrow">State requirement guide</p>
      <h1 data-split-heading>{state.stateName} licensing requirements and exam guidance</h1>
      <p>
        Use this page as a practical planning baseline, then verify final compliance directly with your state board.
      </p>
      <p class="state-hub-link">
        Looking for another state? <a href="/state-requirements">Browse all state requirement pages</a>.
      </p>
    </div>
  </section>

  <section
    class="section section-muted"
    data-module="state-requirements-blocks"
    data-motion-tier="section"
    data-motion-variant="story-stack"
    data-motion-density="cinematic"
  >
    <div class="container">
      <header class="section-heading centered">
        <p class="eyebrow">What to confirm</p>
        <h2>{state.stateName} compliance checklist</h2>
        <p>Scannable requirements designed for quick planning and progress tracking.</p>
      </header>

      <div class="state-requirements-grid">
        {state.requirements.map((requirement, index) => (
          <article class="state-requirement-card reveal">
            <p class="state-requirement-index">Checkpoint {index + 1}</p>
            <p>{requirement}</p>
          </article>
        ))}
      </div>

      <article class="state-trust-callout reveal">
        <h3>What students typically do next</h3>
        <p>
          Many students in {state.stateName} review these checkpoints first, then confirm final details with the
          board before they register.
        </p>
        <p>
          Official board information: <a href={state.boardUrl} target="_blank" rel="noopener noreferrer">Visit board links</a>
        </p>
        <p>Last reviewed: {reviewedLabel}</p>
      </article>

      <article class="cross-link-panel reveal">
        <h3>Helpful next steps</h3>
        <ul>
          <li><a href="/exam-prep">Compare exam prep options</a></li>
          <li><a href={`/start-trial?state=${state.stateCode}`}>Generate your personalized 7-day study plan</a></li>
          <li><a href="/continuing-education">Browse continuing education catalog</a></li>
        </ul>
        <p>
          You may also want to compare nearby states: {neighboringStates.map((code, index) => (
            <>
              <a href={`/state-requirements/${code.toLowerCase()}`}>{stateCodeToName(code)}</a>{index < neighboringStates.length - 1 ? " | " : ""}
            </>
          ))}
        </p>
      </article>
    </div>
  </section>

  <CTASection
    title={`Build your ${state.stateName} exam plan`}
    description="Start your free trial and get a personalized study plan aligned to your timeline and licensing context."
    ctaHref={`/start-trial?state=${state.stateCode}`}
  />
</BaseLayout>
