---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CTASection from "@/components/CTASection.astro";
import StateRequirementsDirectory from "@/components/islands/StateRequirementsDirectory";
import { getStateRequirements } from "@/lib/content";

const states = await getStateRequirements();
---

<BaseLayout
  title="State Requirements | Agents of Change"
  description="Browse social work exam and licensing guidance by state."
  path="/state-requirements"
  themeIntent="trust"
  enableMotionEngine={true}
>
  <section
    class="page-hero page-hero-rich"
    data-module="state-index-hero"
    data-motion-tier="hero"
    data-motion-variant="story-stack"
    data-motion-density="cinematic"
  >
    <div class="container">
      <p class="eyebrow">State lookup</p>
      <h1>Find social work licensing requirements by state</h1>
      <p>
        Browse state-by-state requirement pages and use them to plan your exam timeline.
      </p>
    </div>
  </section>

  <section
    class="section section-muted"
    data-module="state-index-grid"
    data-motion-tier="section"
    data-motion-variant="reveal-stagger"
    data-motion-density="compact"
  >
    <div class="container">
      <StateRequirementsDirectory client:load states={states} />
    </div>
  </section>

  <CTASection
    title="Turn state requirements into a study plan"
    description="Start your free trial to build a study plan aligned to your state and target exam window."
  />
</BaseLayout>
