---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CTASection from "@/components/CTASection.astro";
import InstructorSpotlight from "@/components/InstructorSpotlight.astro";
import StudyJourneyTimeline from "@/components/StudyJourneyTimeline.astro";
import CareerTimeline from "@/components/CareerTimeline.astro";
import { getInstructorProfile, getSeoMetadata, getStudyPhases, getCareerPhases } from "@/lib/content";
import { findSeoByKey } from "@/lib/seo";

const [instructor, phases, careerPhases, seoEntries] = await Promise.all([
  getInstructorProfile(),
  Promise.resolve(getStudyPhases()),
  Promise.resolve(getCareerPhases()),
  getSeoMetadata(),
]);
const seo = findSeoByKey(seoEntries, "about");
---

<BaseLayout
  title={seo?.title ?? "About Agents of Change"}
  description={seo?.description ?? "Meet the team and teaching approach behind Agents of Change."}
  path="/about"
  themeIntent="editorial"
  enableMotionEngine={true}
>
  <section class="page-hero page-hero-rich" data-module="about-hero" data-motion-tier="hero" data-motion-variant="story-stack" data-motion-density="cinematic">
    <div class="container">
      <p class="eyebrow">About us</p>
      <h1 data-split-heading>A teaching system built by social workers for social workers</h1>
      <p>
        Agents of Change helps social workers study with more clarity, stronger reasoning, and a plan they can
        actually follow.
      </p>
    </div>
  </section>

  <InstructorSpotlight profile={instructor} />

  <section class="section section-muted" aria-labelledby="methodology-title" data-module="methodology-framework" data-motion-tier="section">
    <div class="container">
      <header class="section-heading centered">
        <p class="eyebrow">Methodology</p>
        <h2 id="methodology-title">How we teach</h2>
        <p>Three principles guide every lesson, practice question, and support recommendation.</p>
      </header>

      <div class="framework-grid" data-stagger="up">
        <article class="framework-card reveal" data-stagger-item data-tilt>
          <h3>Clear, practical teaching</h3>
          <p>Break complex exam logic into actionable decision patterns students can reuse.</p>
        </article>
        <article class="framework-card reveal" data-stagger-item data-tilt>
          <h3>Application over memorization</h3>
          <p>Prioritize rationale and scenario interpretation to improve transfer under pressure.</p>
        </article>
        <article class="framework-card reveal" data-stagger-item data-tilt>
          <h3>Confidence through clear next steps</h3>
          <p>Every student should know the next highest-impact step to take.</p>
        </article>
      </div>
    </div>
  </section>

  <CareerTimeline phases={careerPhases} />
  <StudyJourneyTimeline phases={phases} />

  <CTASection
    title="See how our approach applies to your exam"
    description="Start your free trial and get a personalized first-week study plan based on your exam track and timeline."
  />
</BaseLayout>
