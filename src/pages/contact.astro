---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CTASection from "@/components/CTASection.astro";
import SupportPathways from "@/components/SupportPathways.astro";
import SupportRouter from "@/components/islands/SupportRouter";
import { getContactPathways, getSeoMetadata } from "@/lib/content";
import { findSeoByKey } from "@/lib/seo";

const pathways = getContactPathways();
const seoEntries = await getSeoMetadata();
const seo = findSeoByKey(seoEntries, "contact");
---

<BaseLayout
  title={seo?.title ?? "Contact Agents of Change"}
  description={seo?.description ?? "Get support for exam prep, licensing, and CE needs."}
  path="/contact"
  themeIntent="trust"
>
  <section class="page-hero page-hero-rich" data-module="contact-hero" data-motion-tier="hero">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Reach the right team</h1>
      <p>
        Get accurate help quickly, whether you need enrollment support, licensing guidance, or continuing education
        help.
      </p>
    </div>
  </section>

  <SupportPathways pathways={pathways} />

  <section class="section section-muted" aria-labelledby="router-title" data-module="contact-router" data-motion-tier="section">
    <div class="container">
      <header class="section-heading centered">
        <p class="eyebrow">Get started</p>
        <h2 id="router-title">Start your message with the right details</h2>
        <p>Choose your topic, add a few details, and open the best next step.</p>
      </header>

      <SupportRouter client:load pathways={pathways} />
    </div>
  </section>

  <section class="section" aria-labelledby="sla-title" data-module="contact-sla" data-motion-tier="section">
    <div class="container">
      <header class="section-heading centered">
        <p class="eyebrow">Response times</p>
        <h2 id="sla-title">When you can expect a reply</h2>
      </header>

      <div class="sla-grid">
        <article class="info-card reveal">
          <h3>Enrollment support</h3>
          <p>Reply target: within 1 business day.</p>
        </article>
        <article class="info-card reveal">
          <h3>Licensing guidance</h3>
          <p>Reply target: within 1-2 business days.</p>
        </article>
        <article class="info-card reveal">
          <h3>CE support</h3>
          <p>Reply target: within 1 business day.</p>
        </article>
      </div>
    </div>
  </section>

  <CTASection
    title="Want a faster path than email threads?"
    description="Start your free trial and get an immediate study plan while our team handles any follow-up questions."
  />
</BaseLayout>
