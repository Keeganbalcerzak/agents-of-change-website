---
const cityGroups = [
  { city: "Chicago, IL", focus: "LCSW Prep and Networking", members: "420+" },
  { city: "New York, NY", focus: "LMSW Study Group", members: "850+" },
  { city: "Los Angeles, CA", focus: "Clinical Peer Support", members: "630+" },
  { city: "Atlanta, GA", focus: "Exam Strategy Accountability", members: "340+" },
];

const specialtyGroups = [
  "Child and adolescent practice",
  "Couples and family counseling",
  "Substance use treatment",
  "School social work",
  "Medical and hospital social work",
  "Private practice growth",
];
---

<section class="section section-muted community-preview" aria-labelledby="community-preview-title" data-module="community-preview">
  <div class="container">
    <header class="section-heading centered">
      <p class="eyebrow">Community</p>
      <h2 id="community-preview-title">Meet social workers studying near you</h2>
      <p>
        Connect by city and specialty so support stays relevant whether you are preparing for the exam or already
        licensed. Join study groups, mentorship, virtual meetups, and an alumni network that grows with your career.
      </p>
    </header>

    <div class="community-preview-grid">
      <article class="community-preview-card reveal">
        <h3>City-based cohorts</h3>
        <p>Groups are organized around major metro areas where members can prepare and network together.</p>
        <ul>
          {cityGroups.map((group) => (
            <li>
              <strong>{group.city}</strong> - {group.focus} ({group.members} members)
            </li>
          ))}
        </ul>
        <a href="/community?view=groups" class="button secondary" data-cta="community-local-groups" data-cta-location="home-community">
          Explore local groups
        </a>
      </article>

      <article class="community-preview-card reveal">
        <h3>Specialty forums</h3>
        <p>Find peers with shared clinical interests and compare study strategy, renewal planning, and real-world practice questions.</p>
        <ul>
          {specialtyGroups.map((topic) => (
            <li>{topic}</li>
          ))}
        </ul>
        <a href="/community?view=forums" class="button secondary" data-cta="community-specialty-forums" data-cta-location="home-community">
          View specialty spaces
        </a>
      </article>

      <article class="community-preview-card reveal">
        <h3>Mentorship, events, and alumni</h3>
        <p>Go beyond study groups with structured support designed for early-career and experienced practitioners alike.</p>
        <ul>
          <li>Mentorship pairing with experienced clinicians</li>
          <li>Monthly "Ask a Clinician" live Q&A sessions</li>
          <li>Virtual meetups and early career cohorts</li>
          <li>Exclusive alumni network for Agents of Change graduates</li>
        </ul>
        <a href="/community#mentorship-network" class="button secondary" data-cta="community-mentorship" data-cta-location="home-community">
          Explore mentorship and events
        </a>
      </article>
    </div>

  </div>
</section>
