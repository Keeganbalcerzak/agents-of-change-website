---
interface Props {
  title: string;
  description: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title,
  description,
  ctaLabel = "Start Free Trial",
  ctaHref = "/start-trial",
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="section cta-panel" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta-card">
      <h2 id="cta-title">{title}</h2>
      <p>{description}</p>
      <div class="cta-actions">
        <a href={ctaHref} class="button primary" data-cta="section-start-trial" data-cta-location="cta-panel">
          {ctaLabel}
        </a>
        {secondaryLabel && secondaryHref && (
          <a href={secondaryHref} class="button secondary" data-cta="section-secondary" data-cta-location="cta-panel">
            {secondaryLabel}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
