---
const productLanes = [
  {
    id: "prep",
    label: "Test Prep",
    title: "Pass the ASWB exam with structure, proof, and live support.",
    copy:
      "Built for pre-licensure social workers who need a focused plan, rationale-based teaching, and support that fits work, practicum, family, and commute reality.",
    bullets: [
      "One-time purchase with access until you pass",
      "Practice exams, case-based rationales, and live study groups",
      "Designed for BSW, LSW, LMSW, and LCSW tracks",
    ],
    ctaLabel: "See exam prep packages",
    ctaHref: "/exam-prep#offers",
    className: "is-prep",
  },
  {
    id: "ce",
    label: "Continuing Education",
    title: "Maintain licensure with confident, state-aware CE planning.",
    copy:
      "Built for licensed professionals who need renewal clarity, practical course selection, and CE options that feel relevant to their actual work.",
    bullets: [
      "Unlimited CE and live events for licensed social workers",
      "State requirement awareness and renewal-focused planning",
      "Professional development beyond minimum hour compliance",
    ],
    ctaLabel: "Browse CE courses",
    ctaHref: "/continuing-education",
    className: "is-ce",
  },
];


---

<section
  id="how-it-works"
  class="section transformation-intro"
  aria-labelledby="transformation-intro-title"
  data-module="home-transformation-intro"
  data-motion-tier="section"
  data-motion-variant="reveal-stagger"
  data-motion-density="compact"
>
  <div class="container">
    <div class="transformation-intro-shell">
      <header class="section-heading transformation-intro-heading">
        <p class="eyebrow">Choose your path</p>
        <h2 id="transformation-intro-title" data-split-heading>
          Choose the option that fits where you are right now.
        </h2>
        <p>
          Agents of Change supports social workers at two key stages: exam prep before licensure and continuing
          education after you pass. This page helps you choose the right place to start.
        </p>
      </header>

      <aside class="transformation-position-card reveal">
        <p class="transformation-position-kicker">How to start</p>
        <h3>Prepare now. Maintain later.</h3>
        <p>
          Start with exam prep if you are working toward licensure. Move to continuing education after you pass and
          need renewal support, live learning, and practical CE courses.
        </p>

        <ul class="transformation-position-list">
          <li><strong>Before licensure:</strong> structured prep, simulations, and study support</li>
          <li><strong>At pass:</strong> a clean transition into state-aware renewal planning</li>
          <li><strong>After licensure:</strong> CE memberships and live learning for ongoing growth</li>
        </ul>

        <div class="transformation-position-actions">
          <a href="/exam-prep#offers" class="button primary btn-magnetic" data-magnetic>
            Compare prep options
          </a>
          <a href="/continuing-education" class="button secondary">
            See CE options
          </a>
        </div>
      </aside>
    </div>

    <div class="product-lane-grid" data-stagger="up">
      {productLanes.map((lane) => (
        <article class:list={["product-lane-card", lane.className]} data-stagger-item data-tilt>
          <p class="product-lane-label">{lane.label}</p>
          <h3>{lane.title}</h3>
          <p>{lane.copy}</p>
          <ul>
            {lane.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
          <a href={lane.ctaHref} class:list={["button", lane.id === "prep" ? "primary" : "secondary", "block"]}>
            {lane.ctaLabel}
          </a>
        </article>
      ))}
    </div>


  </div>
</section>
