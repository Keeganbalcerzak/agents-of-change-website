---
import type { BillingCadence, PricingSection } from "@/lib/types";

interface Props {
  sections: PricingSection[];
}

const { sections } = Astro.props;

type DisplayPlan = PricingSection["plans"][number] & {
  trackOptions?: string[];
};

function cadenceLabel(cadence: BillingCadence): string {
  if (cadence === "free") return "Free";
  if (cadence === "one-time") return "One-time";
  if (cadence === "monthly") return "Monthly";
  return "Annual";
}

function displayPlans(section: PricingSection): DisplayPlan[] {
  if (section.id !== "exam-prep-courses") {
    return section.plans.map((plan) => plan);
  }

  const bswPlan = section.plans.find((plan) => plan.id === "bsw-course");
  const basicsTemplate = section.plans.find((plan) => plan.id === "lmsw-basics");
  const premiumTemplate = section.plans.find((plan) => plan.id === "lmsw-premium");

  const examPrepPlans: Array<DisplayPlan | null> = [
    bswPlan
      ? {
          ...bswPlan,
          ctaLabel: "Open BSW package",
          ctaHref: "/exam-prep?examTrack=BSW#offers",
          trackOptions: ["BSW"],
        }
      : null,
    basicsTemplate
      ? {
          ...basicsTemplate,
          id: "basics-family",
          title: "Basics",
          subtitle: "Choose LMSW or LCSW",
          ctaLabel: "Pick your Basics track",
          ctaHref: "/exam-prep#offers",
          trackOptions: ["LMSW", "LCSW"],
        }
      : null,
    premiumTemplate
      ? {
          ...premiumTemplate,
          id: "premium-family",
          title: "Premium + Power Pack",
          subtitle: "Choose LMSW or LCSW",
          ctaLabel: "Pick your Premium track",
          ctaHref: "/exam-prep#offers",
          trackOptions: ["LMSW", "LCSW"],
        }
      : null,
  ];

  return examPrepPlans.filter((plan): plan is DisplayPlan => plan !== null);
}

function planFit(plan: DisplayPlan, sectionId: string): string | null {
  if (sectionId !== "exam-prep-courses") return null;

  if (plan.id === "bsw-course") return "Best for the dedicated BSW exam path";
  if (plan.id === "basics-family") return "Best for a lower-cost guided prep path";
  if (plan.id === "premium-family") return "Best for full-course prep with more practice and support";

  return null;
}

function comparisonRow(plan: DisplayPlan, sectionId: string): string[] {
  if (sectionId === "exam-prep-courses") {
    if (plan.id === "bsw-course") return ["Until you pass", "Structured course", "Self-paced"];
    if (plan.id === "basics-family") return ["Until you pass", "30+ hours of content", "Live study groups"];
    if (plan.id === "premium-family") return ["Until you pass", "170-question exam", "Priority support"];
  }

  if (sectionId === "continuing-education") {
    if (plan.id === "ce-annual") return ["150+ courses", "15+ live webinars", "ASWB ACE"];
  }

  return [];
}

function visibleFeatures(plan: DisplayPlan, sectionId: string): string[] {
  if (sectionId === "exam-prep-courses" && plan.id === "basics-family") {
    return [
      "30+ hours of content",
      "2 live study groups each month",
      "Access until you pass",
    ];
  }

  if (sectionId === "exam-prep-courses" && plan.id === "premium-family") {
    return [
      "Everything in Basics",
      "170-question practice exam and rationales",
      "Case vignettes with video rationales",
      "25+ recorded study groups",
      "Priority email and chat support",
    ];
  }

  return plan.features.slice(0, 4);
}

const prepSection = sections.find((section) => section.id === "exam-prep-courses");
const ceSection = sections.find((section) => section.id === "continuing-education");
---

<section
  id="pricing"
  class="section section-muted pricing-truth"
  aria-labelledby="pricing-truth-title"
  data-module="pricing-truth"
  data-motion-variant="reveal-stagger"
  data-motion-density="compact"
>
  <div class="container">
    <header class="section-heading centered">
      <p class="eyebrow">Programs and pricing</p>
      <h2 id="pricing-truth-title">Choose the option you need right now</h2>
      <p>
        Exam prep is designed to help you pass. Continuing education is designed to help you stay current after
        licensure.
      </p>
    </header>

    <div class="pricing-positioning-note">
      <p class="pricing-positioning-kicker">Start here</p>
      <p>
        If you are still working toward licensure, buy for exam readiness. If you are already licensed, buy for
        renewal confidence and practical CE value.
      </p>
      <p>
        Test Prep users can transition into CE at <strong>$49 for the first year</strong>, then move to the standard
        <strong>$99 annual membership</strong>.
      </p>
    </div>

    <div class="pricing-lane-stack">
      {prepSection && (
        <section class="pricing-lane pricing-lane-prep" aria-labelledby={`pricing-${prepSection.id}`}>
          <header class="pricing-lane-header">
            <div>
              <p class="pricing-lane-kicker">Test Prep</p>
              <h3 id={`pricing-${prepSection.id}`}>{prepSection.title}</h3>
              <p>{prepSection.description}</p>
            </div>
            <a href="/exam-prep#offers" class="button secondary pricing-lane-cta">
              Explore test prep
            </a>
          </header>

          <div class="pricing-plan-grid is-exam-prep-grid">
            {displayPlans(prepSection).map((plan) => (
              <article
                class:list={[
                  "pricing-plan-card",
                  "reveal",
                  "is-exam-prep-card",
                  plan.tags?.includes("popular") && "is-popular",
                ]}
              >
                <div class="pricing-plan-head">
                  <p class="pricing-plan-title">{plan.title}</p>
                  {plan.subtitle && <p class="pricing-plan-subtitle">{plan.subtitle}</p>}
                  {plan.badge && <p class="pricing-plan-badge">{plan.badge}</p>}
                  {plan.trackOptions && (
                    <div class="pricing-plan-track-pills" aria-label={`${plan.title} available tracks`}>
                      {plan.trackOptions.map((track) => (
                        <span>{track}</span>
                      ))}
                    </div>
                  )}
                  {planFit(plan, prepSection.id) && <p class="pricing-plan-fit-copy">{planFit(plan, prepSection.id)}</p>}
                </div>

                <p class="pricing-plan-price">
                  {plan.regularPrice !== undefined && <span class="pricing-plan-regular-price">${plan.regularPrice}</span>}
                  {plan.price === undefined ? "Free" : `$${plan.price}`}
                  <span>{cadenceLabel(plan.cadence)}</span>
                </p>

                {plan.savingsCopy && <p class="pricing-plan-savings">{plan.savingsCopy}</p>}
                {plan.questionCount && <p class="pricing-plan-questions">{plan.questionCount} total questions</p>}
                {comparisonRow(plan, prepSection.id).length > 0 && (
                  <div class="pricing-plan-compare-line" aria-label={`${plan.title} key comparison points`}>
                    {comparisonRow(plan, prepSection.id).map((item) => (
                      <span>{item}</span>
                    ))}
                  </div>
                )}

                <ul>
                  {visibleFeatures(plan, prepSection.id).map((feature) => (
                    <li>{feature}</li>
                  ))}
                </ul>

                <a
                  href={plan.ctaHref}
                  class="button primary block"
                  data-cta="pricing-plan-cta"
                  data-cta-location={plan.id}
                  data-pricing-plan-id={plan.id}
                >
                  {plan.ctaLabel}
                </a>
              </article>
            ))}
          </div>
        </section>
      )}

      {ceSection && (
        <section class="pricing-lane pricing-lane-ce" aria-labelledby={`pricing-${ceSection.id}`}>
          <div class="pricing-lane-ce-shell">
            <header class="pricing-lane-header">
              <div>
                <p class="pricing-lane-kicker">Continuing Education</p>
                <h3 id={`pricing-${ceSection.id}`}>{ceSection.title}</h3>
                <p>{ceSection.description}</p>
              </div>
              <a href="/continuing-education" class="button secondary pricing-lane-cta">
                Explore continuing education
              </a>
            </header>

            <div class="pricing-ce-highlight">
              <p class="pricing-ce-highlight-kicker">Transition offer</p>
              <p>
                Test Prep users can move into CE at <strong>$49 for year one</strong>, then renew at
                <strong> $99 annually</strong>.
              </p>
            </div>

            <div class="pricing-plan-grid pricing-plan-grid-ce">
              {displayPlans(ceSection).map((plan) => (
                <article class:list={["pricing-plan-card", "reveal", "is-ce-card", "is-ce-featured"]}>
                  <div class="pricing-plan-head">
                    <p class="pricing-plan-title">{plan.title}</p>
                    {plan.subtitle && <p class="pricing-plan-subtitle">{plan.subtitle}</p>}
                    {plan.badge && <p class="pricing-plan-badge">{plan.badge}</p>}
                  </div>

                  <p class="pricing-plan-price">
                    {plan.regularPrice !== undefined && <span class="pricing-plan-regular-price">${plan.regularPrice}</span>}
                    {plan.price === undefined ? "Free" : `$${plan.price}`}
                    <span>{cadenceLabel(plan.cadence)}</span>
                  </p>

                  {plan.savingsCopy && <p class="pricing-plan-savings">{plan.savingsCopy}</p>}
                  {comparisonRow(plan, ceSection.id).length > 0 && (
                    <div class="pricing-plan-compare-line" aria-label={`${plan.title} key comparison points`}>
                      {comparisonRow(plan, ceSection.id).map((item) => (
                        <span>{item}</span>
                      ))}
                    </div>
                  )}

                  <ul>
                    {visibleFeatures(plan, ceSection.id).map((feature) => (
                      <li>{feature}</li>
                    ))}
                  </ul>

                  <a
                    href={plan.ctaHref}
                    class="button primary block"
                    data-cta="pricing-plan-cta"
                    data-cta-location={plan.id}
                    data-pricing-plan-id={plan.id}
                  >
                    {plan.ctaLabel}
                  </a>
                </article>
              ))}
            </div>
          </div>
        </section>
      )}
    </div>
  </div>

  <script is:inline>
    (() => {
      if (window.__aocPricingPlanTrackingBound === true) {
        return;
      }

      window.__aocPricingPlanTrackingBound = true;

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) {
          return;
        }

        const planCta = target.closest("[data-pricing-plan-id]");
        if (!(planCta instanceof HTMLElement)) {
          return;
        }

        const planId = planCta.getAttribute("data-pricing-plan-id") || "unknown";

        if (typeof window.gtag === "function") {
          window.gtag("event", "pricing_plan_select", { plan_id: planId });
        }

        if (Array.isArray(window.dataLayer)) {
          window.dataLayer.push({ event: "pricing_plan_select", plan_id: planId });
        }
      });
    })();
  </script>
</section>
