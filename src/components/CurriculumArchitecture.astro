---
import type { SectionMotionDensity, SectionMotionVariant } from "@/lib/types";

const pillars = [
  {
    title: "Diagnostic Baseline",
    details: "Identify score risks by domain before committing study time.",
  },
  {
    title: "High-Yield Learning",
    details: "Focus on the domains most likely to move your score.",
  },
  {
    title: "Application Practice",
    details: "Turn concepts into stronger scenario answers through rationale review.",
  },
  {
    title: "Simulation and Readiness",
    details: "Run timed sessions and confidence checks to lock in pacing.",
  },
];

interface Props {
  motionVariant?: SectionMotionVariant;
  motionDensity?: SectionMotionDensity;
}

const { motionVariant = "reveal-stagger", motionDensity = "compact" } = Astro.props;
---

<section
  class="section"
  aria-labelledby="architecture-title"
  data-module="curriculum-architecture"
  data-motion-tier="section"
  data-motion-variant={motionVariant}
  data-motion-density={motionDensity}
>
  <div class="container">
    <header class="section-heading centered">
      <p class="eyebrow">How the course is built</p>
      <h2 id="architecture-title">A four-part study system</h2>
      <p>Each lesson is designed to help you focus, practice, and build confidence in the right order.</p>
    </header>

    <div class="architecture-grid">
      {pillars.map((pillar, index) => (
        <article class="architecture-card reveal" style={`--architecture-index:${index + 1};`}>
          <p class="architecture-step">Layer {index + 1}</p>
          <h3>{pillar.title}</h3>
          <p>{pillar.details}</p>
        </article>
      ))}
    </div>
  </div>
</section>
